# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hillshome?schema=public"

# Auth: generate with `openssl rand -base64 48`
AUTH_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Uploads (local driver for development)
UPLOAD_DIR="./uploads"

# Email (optional). Set EMAIL_ENABLED=true to send notifications.
EMAIL_ENABLED="false"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""
ADMIN_NOTIFY_EMAIL=""

# Seed only: initial super admin (change immediately after first login)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
