# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hillshome?schema=public"

# Auth: generate with `openssl rand -base64 48`
AUTH_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Uploads: local disk in development. In production set BLOB_READ_WRITE_TOKEN
# (Vercel adds it automatically when you connect a Blob store) for permanent
# storage; without it files go to /tmp and do not survive redeploys.
UPLOAD_DIR="./uploads"
BLOB_READ_WRITE_TOKEN=""

# Email (optional). Set EMAIL_ENABLED=true to send notifications.
EMAIL_ENABLED="false"
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""
ADMIN_NOTIFY_EMAIL=""

# SMS via Africa's Talking (optional). Set SMS_ENABLED=true to text customers
# who prefer SMS. Sign up at https://africastalking.com, then fill in:
SMS_ENABLED="false"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER=""

# Seed only: initial super admin (change immediately after first login)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
