generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum RequestStatus {
  PENDING
  IN_REVIEW
  QUOTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum RequestKind {
  BOOKING
  SERVICE
  QUOTATION
}

model User {
  id           String           @id @default(cuid())
  name         String
  email        String           @unique
  passwordHash String
  role         Role             @default(STAFF)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  assigned     ServiceRequest[] @relation("Assignee")
  notes        InternalNote[]
}

model ServiceCategory {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  shortDescription String
  description      String
  imageUrl         String?
  kind             RequestKind
  published        Boolean          @default(true)
  sortOrder        Int              @default(0)
  services         Service[]
  requests         ServiceRequest[]
}

model Service {
  id          String           @id @default(cuid())
  categoryId  String
  category    ServiceCategory  @relation(fields: [categoryId], references: [id])
  slug        String           @unique
  name        String
  description String?
  published   Boolean          @default(true)
  /// false = not confirmed as an operational service (e.g. tramway)
  available   Boolean          @default(true)
  requests    ServiceRequest[]

  @@index([categoryId])
}

model ServiceRequest {
  id            String                 @id @default(cuid())
  reference     String                 @unique
  categoryId    String
  category      ServiceCategory        @relation(fields: [categoryId], references: [id])
  serviceId     String?
  service       Service?               @relation(fields: [serviceId], references: [id])
  tourId        String?
  tour          Tour?                  @relation(fields: [tourId], references: [id])
  customerName  String
  email         String
  phone         String
  preferredDate DateTime?
  location      String?
  requirements  String?
  /// Category-specific fields, validated by Zod before saving
  details       Json
  status        RequestStatus          @default(PENDING)
  assigneeId    String?
  assignee      User?                  @relation("Assignee", fields: [assigneeId], references: [id])
  attachments   RequestAttachment[]
  history       RequestStatusHistory[]
  notes         InternalNote[]
  quotes        Quote[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([assigneeId])
}

model RequestAttachment {
  id           String         @id @default(cuid())
  requestId    String
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime       @default(now())

  @@index([requestId])
}

model RequestStatusHistory {
  id          String         @id @default(cuid())
  requestId   String
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  RequestStatus?
  toStatus    RequestStatus
  changedById String?
  createdAt   DateTime       @default(now())

  @@index([requestId])
}

model Quote {
  id         String         @id @default(cuid())
  requestId  String
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  amount     Decimal        @db.Decimal(14, 2)
  currency   String         @default("RWF")
  details    String
  validUntil DateTime?
  status     QuoteStatus    @default(DRAFT)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([requestId])
}

model Tour {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  shortDescription String
  description      String
  destination      String
  durationDays     Int
  /// null = "Price on request" (never invent prices)
  price            Decimal?         @db.Decimal(12, 2)
  currency         String           @default("USD")
  mainImage        String?
  included         String[]
  excluded         String[]
  requirements     String[]
  available        Boolean          @default(true)
  published        Boolean          @default(false)
  archivedAt       DateTime?
  isDemo           Boolean          @default(false)
  images           TourImage[]
  requests         ServiceRequest[]

  @@index([published, archivedAt])
}

model TourImage {
  id        String @id @default(cuid())
  tourId    String
  tour      Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int    @default(0)
}

model GalleryItem {
  id           String  @id @default(cuid())
  categorySlug String
  title        String
  url          String
  alt          String
  published    Boolean @default(true)
  isDemo       Boolean @default(false)
  createdAt    DateTime @default(now())
}

model InternalNote {
  id        String         @id @default(cuid())
  requestId String
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String
  author    User           @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime       @default(now())

  @@index([requestId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

/// Editable site content: contact details, about text, placeholders
model SiteSetting {
  key   String @id
  value Json
}

/// Atomic counters (request reference numbers)
model Counter {
  key   String @id
  value Int
}
